{
    "name": "thaumcraft-research-helper",
    "description": "A simple, web-based research helper for older versions of Thaumcraft.",
    "version": "0.0.1",
    "license": "SEE LICENSE IN LICENSE.md",
    "private": true,
    "author": {
        "name": "G'lek Tarssza",
        "email": "glek@glektarssza.com",
        "url": "https://glektarssza.com"
    },
    "homepage": "https://github.com/glektarssza/thaumcraft-research-helper",
    "bugs": {
        "url": "https://github.com/glektarssza/thaumcraft-research-helper/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/glektarssza/thaumcraft-research-helper"
    },
    "directories": {
        "doc": "./docs/",
        "example": "./examples/",
        "lib": "./lib/",
        "test": "./tests/"
    },
    "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
    "type": "module",
    "scripts": {
        "dev": "vite serve --mode development",
        "preview": "vite preview",
        "test": "run-p test:unit test:e2e",
        "test:unit": "vitest --run --coverage",
        "test:unit:ci": "vitest --run --coverage",
        "test:unit:ui": "vitest --ui",
        "test:e2e": "playwright test",
        "lint": "pnpm run eslint && pnpm run prettier",
        "lint:fix": "pnpm run eslint:fix && pnpm run prettier:fix",
        "lint:ci": "pnpm run eslint:ci && pnpm run prettier:ci",
        "eslint": "eslint --no-error-on-unmatched-pattern --cache ./src/ ./tests/",
        "eslint:fix": "eslint --no-error-on-unmatched-pattern --cache --fix ./src/ ./tests/",
        "eslint:ci": "eslint --no-error-on-unmatched-pattern ./src/ ./tests/",
        "prettier": "prettier --config ./.prettierrc.mjs --ignore-path ./.prettierignore --ignore-path ./.gitignore --cache --check .",
        "prettier:fix": "prettier --config ../.prettierrc.mjs --ignore-path ./.prettierignore --ignore-path ./.gitignore --cache --write .",
        "prettier:ci": "prettier --config ./.prettierrc.mjs --ignore-path ./.prettierignore --ignore-path ./.gitignore --check .",
        "build": "pnpm run build:prod",
        "build:all": "pnpm run build:production && pnpm run build:development",
        "build:prod": "pnpm run build:production",
        "build:production": "vite build --mode production",
        "build:dev": "pnpm run build:development",
        "build:development": "vite build --mode development",
        "clean": "pnpm run clean:prod",
        "clean:all": "pnpm run clean:production && pnpm run clean:development",
        "clean:prod": "pnpm run clean:production",
        "clean:production": "del-cli \"./dist/\"",
        "clean:dev": "pnpm run clean:dev",
        "clean:development": "del-cli \"./dist/\"",
        "rebuild": "pnpm run rebuild:prod",
        "rebuild:all": "pnpm run clean:all && pnpm run build:all",
        "rebuild:prod": "pnpm run clean:prod && pnpm run build:prod",
        "rebuild:dev": "pnpm run clean:dev && pnpm run build:dev"
    },
    "dependencies": {
        "vue": "^3.5.24"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@faker-js/faker": "^10.2.0",
        "@playwright/test": "^1.56.1",
        "@rollup/plugin-replace": "^6.0.3",
        "@tsconfig/node24": "^24.0.1",
        "@types/jsdom": "^27.0.0",
        "@types/node": "^25.0.7",
        "@vitest/browser": "^4.0.17",
        "@vitest/browser-playwright": "^4.0.17",
        "@vitest/coverage-istanbul": "^4.0.17",
        "@vitest/eslint-plugin": "^1.4.1",
        "@vitest/ui": "^4.0.17",
        "@vue/eslint-config-typescript": "^14.6.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "cspell": "9.6.0",
        "del-cli": "^7.0.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.3.0",
        "eslint-plugin-tsdoc": "^0.5.0",
        "eslint-plugin-vue": "^10.5.1",
        "jsdom": "^27.1.0",
        "playwright": "^1.57.0",
        "prettier": "^3.7.4",
        "sass-embedded": "^1.97.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.53.0",
        "vite": "^7.3.1",
        "vite-plugin-vue-devtools": "^8.0.3",
        "vitest": "^4.0.17"
    }
}
